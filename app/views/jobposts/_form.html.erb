<%= form_with(model: jobpost) do |form| %>
  <% if jobpost.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(jobpost.errors.count, "error") %> prohibited this jobpost from being saved:</h2>

      <ul>
        <% jobpost.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
