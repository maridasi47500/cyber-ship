<div id="<%= dom_id news %>">
  <p>
    <strong>User:</strong>
    <%= news.user_id %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= news.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= news.content %>
  </p>

  <p>
    <strong>Pic:</strong>
    <%= news.pic %>
  </p>

  <p>
    <strong>Lat:</strong>
    <%= news.lat %>
  </p>

  <p>
    <strong>Lon:</strong>
    <%= news.lon %>
  </p>

  <p>
    <strong>City:</strong>
    <%= news.city_id %>
  </p>

</div>
